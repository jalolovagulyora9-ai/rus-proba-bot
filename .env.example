# ==========================================
# RUSSIAN PROBA BOT - Environment Variables
# Nusxa oling va nomini .env qilib o'zgartiring
# Hech qachon haqiqiy .env faylini Git-ga yuklamang!
# ==========================================

# --- Django Sozlamalari ---
# Mahalliy muhitda DEBUG=True, production (Render) da DEBUG=False
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-change-this-to-a-very-secret-key-for-local-dev
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# --- Ma'lumotlar Bazasi (PostgreSQL) ---
# Mahalliy test uchun (agar PostgreSQL o'rnatilgan bo'lsa):
# DATABASE_URL=postgres://postgres:parol@localhost:5432/mock_exam_db
# 
# Neon.tech Free PostgreSQL (Production yoki test uchun):
# Eslatma: Connection pooling uchun -pooler manzilidan foydalaning!
DATABASE_URL=postgres://neondb_owner:parol_bu_yerda@ep-cool-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Telegram Bot Sozlamalari ---
# @BotFather orqali olingan bot tokeni
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_sample_token

# --- Webhook Sozlamalari ---
# Mahalliy noutbukda test qilayotganda bo'sh qoldiring (bot polling rejimida ishlaydi).
# Render serverida: WEBHOOK_URL=https://sizning-app-nomingiz.onrender.com/webhook/telegram/
WEBHOOK_URL=

# --- Admin va Xavfsizlik ---
# Django admin panelining yashirin yo'li (standart /admin/ o'rniga)
ADMIN_URL_PATH=portal-exam-ctrl-2026/
